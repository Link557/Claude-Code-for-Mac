{
  "name": "claude-desk",
  "productName": "Claude Code",
  "version": "0.3.52-win.16",
  "private": true,
  "description": "中文 Claude Code 桌面客户端，支持 macOS 与 Windows 原生环境",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/launch.cjs dev",
    "build": "electron-vite build",
    "start": "node scripts/launch.cjs preview",
    "probe": "electron-vite build && node scripts/launch.cjs electron . --probe",
    "pack:win": "npm run build && electron-builder --win dir --x64 --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test-web.json",
    "test": "vitest run",
    "install-app": "zsh scripts/install-app.sh",
    "rebuild-native": "electron-rebuild -f -w node-pty",
    "postinstall": "node scripts/check-native.cjs",
    "pack:mac": "npm run build && electron-builder --mac dir --arm64 --publish never",
    "release:win": "npm run build && electron-builder --win zip --x64 --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.301",
    "@anthropic-ai/sdk": "0.135.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.17",
    "mammoth": "1.13.0",
    "node-pty": "1.1.0",
    "pdfjs-dist": "6.4.299",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@lexical/react": "0.52.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "diff": "9.0.0",
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "jsdom": "30.1.3",
    "lexical": "0.52.0",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7",
    "zustand": "5.0.15"
  },
  "build": {
    "appId": "local.nature.claude-desk.windows",
    "productName": "Claude Code",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "LICENSE",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk*/**",
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "build/icon.ico",
          "to": "icon.ico"
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false,
      "artifactName": "Claude-Code-for-Windows-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": "-",
      "signIgnore": [
        "/@anthropic-ai/claude-agent-sdk-darwin-arm64/claude$"
      ],
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true
    }
  },
  "license": "MIT"
}
